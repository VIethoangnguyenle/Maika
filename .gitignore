.maika/tools/rule-projector/generated/*
!.maika/tools/rule-projector/generated/.gitkeep
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv
.worktrees/

# Packaging build artifacts (wheel bundle is staged into build/ at build time,
# never the source tree; see setup.py).
build/
dist/
*.whl
cli/_assets/

# Workspace scratch cho handoff/review artifact tạm (xem README §Repo hygiene)
.superpowers/

# Per-dev: persona là phong cách tương tác riêng từng developer (seed từ persona.template.yaml)
.maika/knowledge/long-term/persona.yaml
.maika/profiles/execution-mode.local.yaml
.gstack/
